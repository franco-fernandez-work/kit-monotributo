{
  "name": "kit-monotributo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "qr-dinamicos" }],
  "rules": [{ "type": "Data", "globs": ["**/*.xlsx", "**/*.zip", "**/*.pdf"], "fallthrough": false }]
}
